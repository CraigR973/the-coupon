# The Coupon — local environment
# Copy to .env, replace placeholders, and never commit the populated file.

# PostgreSQL (SQLAlchemy asyncpg URL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/the_coupon

# Display-name + PIN authentication
JWT_ACCESS_SECRET=change-me-access-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-with-at-least-32-characters

# Supabase (optional locally; service key is backend-only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Optional LLM integration inherited by the application spine
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096

# Betfair Exchange. Leave blank for automated tests; only the owner runs live checks.
BF_APP_KEY=
BF_USER=
BF_PASS=

# Web Push
VAPID_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=admin@example.com

# App/runtime
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000
SENTRY_DSN_BACKEND=
VITE_SENTRY_DSN=
LOG_LEVEL=INFO
ENVIRONMENT=development
BACKUP_DIR=/tmp/the_coupon_backups
SCHEDULER_ENABLED=true

# Local admin seed
ADMIN_PIN=
