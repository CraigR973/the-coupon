# The Coupon — local environment
# Copy to .env, replace placeholders, and never commit the populated file.

# PostgreSQL (SQLAlchemy asyncpg URL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/the_coupon

# Display-name + PIN authentication
JWT_ACCESS_SECRET=change-me-access-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-with-at-least-32-characters

# Betfair Exchange. Leave blank for automated tests; only the owner runs live checks.
BF_APP_KEY=
BF_USER=
BF_PASS=
BF_CERT_FILE=
BF_KEY_FILE=
# Railway production: base64-encoded PEM values, materialized at the fixed
# BF_CERT_FILE/BF_KEY_FILE paths before the app imports its settings.
BF_CERT_PEM_B64=
BF_KEY_PEM_B64=
# Set true only in development or the dedicated staging environment.
BF_FAKE_MODE=false

# Web Push
VAPID_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=admin@example.com

# App/runtime
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000
LOG_LEVEL=INFO
ENVIRONMENT=development
BACKUP_DIR=/tmp/the_coupon_backups
SCHEDULER_ENABLED=true

# One-off administrator PIN for the roster's sole admin entry.
ADMIN_PIN=
