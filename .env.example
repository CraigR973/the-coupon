# The Coupon — local environment
# Copy to .env, replace placeholders, and never commit the populated file.

# PostgreSQL (SQLAlchemy asyncpg URL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/the_coupon

# Display-name + PIN authentication
JWT_ACCESS_SECRET=change-me-access-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-with-at-least-32-characters

# Odds source: oddsapi (default, production) | betfair (fallback) | fake (canned).
# `fake` is refused in production. See docs/adr/0002-replace-betfair-exchange-with-odds-api-io.md.
ODDS_PROVIDER=oddsapi
# odds-api.io. Required in production when ODDS_PROVIDER=oddsapi.
ODDS_API_KEY=
# One bookmaker prices everything — the game scores by odds, so mixing books would make a
# member's score depend on who priced their fixture. Names are case-sensitive.
ODDS_API_BOOKMAKER=Bet365
ODDS_API_BASE_URL=https://api.odds-api.io/v3
# How long a fetched price may be served from the process cache. `fetch_odds` runs in the
# request path and the free plan allows 100 requests/hour and 500/day, so this is what
# keeps the pick page inside the quota. The launch Saturday carries 131 qualifying
# fixtures = 14 batched requests per refresh, so 900s costs 56/hour; 300s would cost 168.
ODDS_CACHE_TTL_SECONDS=900

# Betfair Exchange — only read when ODDS_PROVIDER=betfair. Leave blank otherwise;
# only the owner runs live checks.
BF_APP_KEY=
BF_USER=
BF_PASS=
BF_CERT_FILE=
BF_KEY_FILE=
# Railway: base64-encoded PEM values, materialized at the fixed BF_CERT_FILE/BF_KEY_FILE
# paths before the app imports its settings. Unused unless ODDS_PROVIDER=betfair.
BF_CERT_PEM_B64=
BF_KEY_PEM_B64=
# Deprecated — superseded by ODDS_PROVIDER=fake. Still honoured for environments sealed
# before ADR 0002, and still refused in production.
BF_FAKE_MODE=false

# Web Push
VAPID_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=admin@example.com

# App/runtime
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000
LOG_LEVEL=INFO
ENVIRONMENT=development
BACKUP_DIR=/tmp/the_coupon_backups
SCHEDULER_ENABLED=true

# One-off administrator PIN for the roster's sole admin entry.
ADMIN_PIN=
